# LLM API配置
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 默认模型
DEFAULT_MODEL=gpt-4

# Sciverse API配置
SCIVERSE_API_KEY=your_sciverse_api_key_here
SCIVERSE_BASE_URL=https://sciverse.opendatalab.com/api

# 本地数据路径
SCI_BASE_DATA_PATH=./data/sci_base

# 数据库配置
POSTGRES_URL=postgresql://localhost:5432/litmat
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# 系统配置
MAX_RETRIEVAL_RESULTS=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# 日志级别
LOG_LEVEL=INFO
